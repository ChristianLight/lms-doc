{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcademicCommentRevision",
  "description": "Approved teacher report narrative separated from grade inputs.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique AcademicCommentRevision identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Educational identity within the same institution.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Educational identity within the same institution."
    },
    "academic_period_id": {
      "type": "string",
      "format": "uuid",
      "description": "Academic period within institution.",
      "x-entity-reference": "AcademicPeriod",
      "x-reference-scope": "Academic period within institution."
    },
    "offering_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional scoped offering.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Optional scoped offering."
    },
    "report_card_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional scoped report identity.",
      "x-entity-reference": "ReportCard",
      "x-reference-scope": "Optional scoped report identity."
    },
    "comment_key": {
      "type": "string",
      "format": "uuid",
      "description": "Stable comment series identifier."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic immutable revision number within its stable identity."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "description": "Plain-text comment or sanitized restricted-rich-text representation."
    },
    "visibility": {
      "type": "string",
      "enum": [
        "learner",
        "approved_delegate",
        "staff_only"
      ],
      "description": "Approved maximum audience."
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approval time, absent for draft."
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approver in valid academic scope.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Approver in valid academic scope."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    }
  },
  "required": [
    "id",
    "institution_id",
    "person_id",
    "academic_period_id",
    "offering_id",
    "report_card_id",
    "comment_key",
    "revision",
    "created_at",
    "body",
    "visibility",
    "approved_at",
    "approved_by",
    "actor_id"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "comment_key",
      "revision"
    ]
  ],
  "x-invariants": [
    "Private comments are never embedded in learner artifacts.",
    "Report issuance pins exact approved revision."
  ]
}
