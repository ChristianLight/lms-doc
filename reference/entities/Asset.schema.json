{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset",
  "description": "Durable resource and rights scope independent of storage bytes.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable opaque identity."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Responsible owner.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Must resolve to an authorized Institution in the owning institution."
    },
    "owner_unit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Scope for editing.",
      "x-entity-reference": "OrganizationUnit",
      "x-reference-scope": "Must resolve to an authorized OrganizationUnit in the owning institution."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Logical asset title."
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "document",
        "video",
        "audio",
        "caption",
        "transcript",
        "archive"
      ],
      "description": "Asset class."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation time."
    }
  },
  "required": [
    "id",
    "institution_id",
    "owner_unit_id",
    "title",
    "kind",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "curriculum",
  "x-unique-keys": [
    [
      "id"
    ]
  ],
  "x-invariants": [
    "Asset can own many exact versions."
  ]
}
