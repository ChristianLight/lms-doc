{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cohort",
  "description": "Institutional grouping reused across offerings.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable opaque identity."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Must resolve to an authorized Institution in the owning institution."
    },
    "owner_unit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Delegated owner.",
      "x-entity-reference": "OrganizationUnit",
      "x-reference-scope": "Must resolve to an authorized OrganizationUnit in the owning institution."
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "description": "Normalized cohort code."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Cohort title."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active",
      "description": "Membership lifecycle."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 1,
      "description": "Compare-and-swap token."
    }
  },
  "required": [
    "id",
    "institution_id",
    "owner_unit_id",
    "code",
    "title",
    "state",
    "revision"
  ],
  "additionalProperties": false,
  "x-owner": "participation",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "code"
    ]
  ],
  "x-invariants": [
    "No direct learning authority without explicit roster grant."
  ]
}
