{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CohortMembership",
  "description": "Effective-dated institution person membership.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable opaque identity."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institutional learner identity.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Must resolve to an authorized Person in the owning institution."
    },
    "cohort_id": {
      "type": "string",
      "format": "uuid",
      "description": "Cohort in same institution.",
      "x-entity-reference": "Cohort",
      "x-reference-scope": "Must resolve to an authorized Cohort in the owning institution."
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive start."
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exclusive end."
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "self",
        "invitation",
        "cohort",
        "roster",
        "rule",
        "transfer"
      ],
      "description": "Provenance."
    },
    "assigned_by": {
      "type": "string",
      "format": "uuid",
      "description": "Actor.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Must resolve to an authorized Principal in the owning institution."
    }
  },
  "required": [
    "id",
    "person_id",
    "cohort_id",
    "effective_from",
    "source",
    "assigned_by"
  ],
  "additionalProperties": false,
  "x-owner": "participation",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "person_id",
      "cohort_id",
      "effective_from"
    ]
  ],
  "x-invariants": [
    "Membership alone never creates offering access."
  ]
}
