{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompetencyFrameworkVersion",
  "description": "Published versioned institutional skill or academic standards hierarchy.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique CompetencyFrameworkVersion identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "framework_key": {
      "type": "string",
      "format": "uuid",
      "description": "Stable framework family."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic immutable revision number within its stable identity."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Approved framework title."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9-]+$",
      "description": "Source definition locale."
    },
    "external_identifier": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ],
      "description": "Verified external standard identifier, if any."
    },
    "issuer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Issuing authority label."
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "superseded",
        "retired"
      ],
      "default": "draft",
      "description": "Framework publishing lifecycle."
    },
    "structure_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approved hierarchy and edges digest."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    }
  },
  "required": [
    "id",
    "institution_id",
    "framework_key",
    "revision",
    "created_at",
    "title",
    "locale",
    "external_identifier",
    "issuer_name",
    "state",
    "structure_digest",
    "actor_id"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "framework_key",
      "revision"
    ]
  ],
  "x-invariants": [
    "Prerequisite and aggregate edges acyclic.",
    "Source lineage and prior version persist."
  ]
}
