{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompetencyVersion",
  "description": "Exact competency text, scale and typed edges within one framework version.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique CompetencyVersion identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "competency_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable competency within same institution and framework.",
      "x-entity-reference": "Competency",
      "x-reference-scope": "Stable competency within same institution and framework."
    },
    "framework_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact framework version.",
      "x-entity-reference": "CompetencyFrameworkVersion",
      "x-reference-scope": "Exact framework version."
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Parent inside same framework version if hierarchical.",
      "x-entity-reference": "CompetencyVersion",
      "x-reference-scope": "Parent inside same framework version if hierarchical."
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true,
      "description": "Required prior mastery nodes in same version.",
      "x-entity-reference": "CompetencyVersion",
      "x-reference-scope": "Required prior mastery nodes in same version."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "description": "Approved display title."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "description": "Definition of expected demonstration."
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "normalized_ratio": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19727})$"
                  },
                  "denominator": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19727}$"
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "label",
          "rank",
          "normalized_ratio"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "minItems": 2,
      "description": "Ordered declared ordinal levels and optional normalized mapping."
    },
    "mastery_level_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Exact threshold level."
    },
    "aggregation_mode": {
      "type": "string",
      "enum": [
        "most_recent",
        "minimum_independent",
        "consecutive",
        "all_criteria"
      ],
      "default": "most_recent",
      "description": "Approved evidence reduction algorithm."
    },
    "lookback_days": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        {
          "type": "null"
        }
      ],
      "description": "Maximum age of observed evidence, null means no age exclusion."
    },
    "minimum_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 1,
      "description": "Number of qualifying observations required."
    }
  },
  "required": [
    "id",
    "institution_id",
    "competency_id",
    "framework_version_id",
    "parent_id",
    "prerequisite_ids",
    "title",
    "description",
    "levels",
    "mastery_level_code",
    "aggregation_mode",
    "lookback_days",
    "minimum_count"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "competency_id",
      "framework_version_id"
    ]
  ],
  "x-invariants": [
    "Level codes and ranks unique.",
    "Ordinal arithmetic requires explicit numeric mapping.",
    "No cyclic dependency edge."
  ]
}
