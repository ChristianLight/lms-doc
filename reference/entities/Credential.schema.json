{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential",
  "description": "Immutable credential claim tied to exact academic qualification or mastery.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique Credential identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Educational identity within the same institution.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Educational identity within the same institution."
    },
    "definition_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Approved exact issuer definition.",
      "x-entity-reference": "CredentialDefinitionVersion",
      "x-reference-scope": "Approved exact issuer definition."
    },
    "qualification_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Authorized exact qualification award if applicable.",
      "x-entity-reference": "QualificationDecision",
      "x-reference-scope": "Authorized exact qualification award if applicable."
    },
    "competency_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approved mastery determination if applicable.",
      "x-entity-reference": "CompetencyDecision",
      "x-reference-scope": "Approved mastery determination if applicable."
    },
    "replaces_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Earlier credential being replaced, if any.",
      "x-entity-reference": "Credential",
      "x-reference-scope": "Earlier credential being replaced, if any."
    },
    "source_key": {
      "type": "string",
      "format": "uuid",
      "description": "Stable issue scope key for uniqueness across nullable source kinds."
    },
    "claim_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Canonical approved immutable credential claim digest."
    },
    "claim_storage_id": {
      "type": "string",
      "format": "uuid",
      "description": "Protected canonical claim representation.",
      "x-entity-reference": "StorageObject",
      "x-reference-scope": "Protected canonical claim representation."
    },
    "verification_key_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Opaque public or authenticated token digest if used."
    },
    "verification_method": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ],
      "description": "Pinned approved signing verification method identifier."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "Official issue instant."
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exclusive expiration when applicable."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    }
  },
  "required": [
    "id",
    "institution_id",
    "person_id",
    "definition_version_id",
    "qualification_id",
    "competency_decision_id",
    "replaces_id",
    "source_key",
    "claim_digest",
    "claim_storage_id",
    "verification_key_digest",
    "verification_method",
    "issued_at",
    "expires_at",
    "actor_id"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "definition_version_id",
      "source_key"
    ],
    [
      "verification_key_digest"
    ]
  ],
  "x-invariants": [
    "Exactly one source basis.",
    "Revoked credentials require separate replacement identity.",
    "Public lookup discloses only approved claims."
  ]
}
