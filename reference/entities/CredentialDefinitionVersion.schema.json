{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialDefinitionVersion",
  "description": "Approved credential appearance, disclosure and verification policy.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique CredentialDefinitionVersion identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "definition_key": {
      "type": "string",
      "format": "uuid",
      "description": "Stable credential family."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic immutable revision number within its stable identity."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Credential display label."
    },
    "issuer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Issuer name pinned for claims."
    },
    "achievement_type": {
      "type": "string",
      "enum": [
        "qualification",
        "competency",
        "microcredential"
      ],
      "description": "Authorized award type."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9-]+$",
      "description": "Credential language."
    },
    "verification_mode": {
      "type": "string",
      "enum": [
        "disabled",
        "authenticated",
        "opaque_link",
        "signed_exchange"
      ],
      "default": "disabled",
      "description": "Issuer verification profile."
    },
    "allowed_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      },
      "maxItems": 32,
      "minItems": 1,
      "uniqueItems": true,
      "description": "Approved field keys eligible for disclosure."
    },
    "signature_profile": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact deployed signing profile when used."
    },
    "valid_days": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional credential lifetime override within award validity."
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "superseded",
        "retired"
      ],
      "default": "draft",
      "description": "Template publication state."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    }
  },
  "required": [
    "id",
    "institution_id",
    "definition_key",
    "revision",
    "created_at",
    "title",
    "issuer_name",
    "achievement_type",
    "locale",
    "verification_mode",
    "allowed_claims",
    "signature_profile",
    "valid_days",
    "state",
    "actor_id"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "definition_key",
      "revision"
    ]
  ],
  "x-invariants": [
    "Public disclosure defaults disabled.",
    "Verification mode and claim set pinned on issue."
  ]
}
