{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalObjectMap",
  "description": "Stable crosswalk between one source namespace and one canonical owner object.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Immutable identity allocated once by the interoperability owner."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institution owning these data and their access policy.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Reference must resolve inside the owning Institution or the directly owned aggregate."
    },
    "source_namespace": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "Registered and verified authoritative source."
    },
    "source_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,55}/[0-9a-z][0-9a-z_.-]{0,31}$",
      "description": "Registered source identity profile. Container variants of the same decoding profile do not create separate identities."
    },
    "source_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Stable source parent scope or root sentinel."
    },
    "object_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Registered mapped canonical type."
    },
    "external_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Exact source identifier retained as an opaque value."
    },
    "record_role": {
      "type": "string",
      "enum": [
        "definition",
        "placement",
        "asset",
        "policy",
        "reference",
        "package",
        "document"
      ],
      "description": "Stable crosswalk role distinguishing definitions from their placement and reference occurrences."
    },
    "occurrence_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Stable occurrence key in the approved source scope, or explicit definition sentinel. A changed ordinal alone cannot retarget an existing mapping."
    },
    "target_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Canonical owner entity type."
    },
    "target_id": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical owner entity UUID, validated via owner adapter."
    },
    "baseline_tracks": {
      "type": "object",
      "properties": {
        "published": {
          "type": "object",
          "properties": {
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "target_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "job_id": {
              "type": "string",
              "format": "uuid"
            },
            "roster_snapshot_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "source_revision",
            "source_fingerprint",
            "target_fingerprint"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "job_id"
              ],
              "not": {
                "required": [
                  "roster_snapshot_id"
                ]
              }
            },
            {
              "required": [
                "roster_snapshot_id"
              ],
              "not": {
                "required": [
                  "job_id"
                ]
              }
            }
          ]
        },
        "draft": {
          "type": "object",
          "properties": {
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "target_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "job_id": {
              "type": "string",
              "format": "uuid"
            },
            "roster_snapshot_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "source_revision",
            "source_fingerprint",
            "target_fingerprint"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "job_id"
              ],
              "not": {
                "required": [
                  "roster_snapshot_id"
                ]
              }
            },
            {
              "required": [
                "roster_snapshot_id"
              ],
              "not": {
                "required": [
                  "job_id"
                ]
              }
            }
          ]
        },
        "shared": {
          "type": "object",
          "properties": {
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "target_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "job_id": {
              "type": "string",
              "format": "uuid"
            },
            "roster_snapshot_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "source_revision",
            "source_fingerprint",
            "target_fingerprint"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "job_id"
              ],
              "not": {
                "required": [
                  "roster_snapshot_id"
                ]
              }
            },
            {
              "required": [
                "roster_snapshot_id"
              ],
              "not": {
                "required": [
                  "job_id"
                ]
              }
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Separate last approved source and target pair by publication layer. Published and draft tracks for one definition keep the same canonical identity."
    },
    "last_job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Successful curriculum transfer receipt for the last accepted import baseline. Absent for provider roster mappings.",
      "x-entity-reference": "TransferJob",
      "x-reference-scope": "Reference must resolve inside the owning Institution or the directly owned aggregate."
    },
    "last_roster_snapshot_id": {
      "type": "string",
      "format": "uuid",
      "description": "Applied roster snapshot receipt for the last accepted feed baseline. Absent for curriculum imports.",
      "x-entity-reference": "RosterSnapshot",
      "x-reference-scope": "Resolve same-institution authorized RosterSnapshot for the exact verified source authority."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "retired",
        "merge_pending"
      ],
      "description": "Authoritative lifecycle state advanced only through owner commands."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic aggregate revision used for compare-and-swap."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last authoritative mapping update."
    }
  },
  "required": [
    "id",
    "institution_id",
    "source_namespace",
    "source_profile",
    "source_scope",
    "object_kind",
    "external_key",
    "record_role",
    "occurrence_key",
    "target_kind",
    "target_id",
    "baseline_tracks",
    "state",
    "revision",
    "updated_at"
  ],
  "additionalProperties": false,
  "x-owner": "interoperability",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "source_namespace",
      "source_profile",
      "source_scope",
      "object_kind",
      "external_key",
      "record_role",
      "occurrence_key"
    ]
  ],
  "x-invariants": [
    "Crosswalk updates require source authority and matching target baseline.",
    "Multiple aliases may identify one native object, but one source tuple cannot identify multiple current targets.",
    "A re-import compares only the matching accepted layer baseline. Local divergence does not advance the baseline or erase published history.",
    "A fork creates an independently scoped source branch or target lineage. It never silently retargets the existing active crosswalk.",
    "Each committed baseline retains exactly one transfer or roster application receipt. A roster or operational baseline uses the shared track and cannot mutate curriculum publication tracks."
  ]
}
