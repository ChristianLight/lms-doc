{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeCorrectionWindow",
  "description": "Time-bounded approval to correct selected closed-period results.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradeCorrectionWindow identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "period_close_id": {
      "type": "string",
      "format": "uuid",
      "description": "Closed period in same offering.",
      "x-entity-reference": "GradePeriodClose",
      "x-reference-scope": "Closed period in same offering."
    },
    "grade_result_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 10000,
      "minItems": 1,
      "uniqueItems": true,
      "description": "Named targets eligible for correction.",
      "x-entity-reference": "GradeResult",
      "x-reference-scope": "Named targets eligible for correction."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "closed"
      ],
      "default": "active",
      "description": "Correction access state."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "description": "Why ordinary closure exception was approved."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    },
    "opens_at": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive start timestamp."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Exclusive authorized end."
    },
    "sealed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Recorded reseal instant if completed."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "period_close_id",
    "grade_result_ids",
    "state",
    "reason",
    "actor_id",
    "opens_at",
    "expires_at",
    "sealed_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ]
  ],
  "x-invariants": [
    "An expired window cannot activate a correction.",
    "Cannot expand scope without new authorization."
  ]
}
