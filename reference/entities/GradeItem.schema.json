{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeItem",
  "description": "Stable offering-scoped gradebook line across policy revisions.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradeItem identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "item_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Stable unique offering-local code."
    },
    "placement_key": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Stable curriculum placement when linked."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Default staff and learner label."
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Exclude from new policy assignment when true."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "item_code",
    "placement_key",
    "title",
    "archived",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "offering_id",
      "item_code"
    ]
  ],
  "x-invariants": [
    "One stable line does not change meaning across incompatible score or identity bindings.",
    "Archive never deletes used policy versions."
  ]
}
