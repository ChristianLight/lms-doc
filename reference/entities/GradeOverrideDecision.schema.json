{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeOverrideDecision",
  "description": "Append-only accepted, rejected or revoked override decision.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradeOverrideDecision identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Approved scoped override request.",
      "x-entity-reference": "GradeOverrideRequest",
      "x-reference-scope": "Approved scoped override request."
    },
    "prior_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Previous decision when superseding or revoking.",
      "x-entity-reference": "GradeOverrideDecision",
      "x-reference-scope": "Previous decision when superseding or revoking."
    },
    "predecessor_key": {
      "type": "string",
      "pattern": "^(root|[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12})$",
      "description": "Canonical nonnull key, root for first decision or prior decision UUID thereafter."
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "revoke"
      ],
      "description": "Recorded registrar action."
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Restricted reason for the action."
    },
    "reviewed_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Exact approved input preview."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "Recorded decision time."
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "description": "Academic effective instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "request_id",
    "prior_decision_id",
    "predecessor_key",
    "decision",
    "decision_reason",
    "reviewed_fingerprint",
    "actor_id",
    "decided_at",
    "effective_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "request_id",
      "predecessor_key"
    ]
  ],
  "x-invariants": [
    "Predecessor key is root only for a first decision and otherwise equals prior decision UUID. Compare request head under lock to prevent branching.",
    "Revocation targets an approved active decision.",
    "Active override on a result cannot silently vanish when source evidence changes."
  ]
}
