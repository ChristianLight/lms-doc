{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradePeriodClose",
  "description": "Gradebook closure guard for one offering and academic period.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradePeriodClose identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "academic_period_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact gradebook reporting period within institution.",
      "x-entity-reference": "AcademicPeriod",
      "x-reference-scope": "Exact gradebook reporting period within institution."
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "closing",
        "closed",
        "correction_open",
        "resealed"
      ],
      "default": "open",
      "description": "Close lifecycle."
    },
    "guard_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 1,
      "description": "Monotonic optimistic concurrency version."
    },
    "checkpoint_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approved grade evidence and expected learner checkpoint."
    },
    "closed_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approver with close permission.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Approver with close permission."
    },
    "closed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Closure instant."
    },
    "resealed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Most recent reseal instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "academic_period_id",
    "state",
    "guard_version",
    "checkpoint_digest",
    "closed_by",
    "closed_at",
    "resealed_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "offering_id",
      "academic_period_id"
    ]
  ],
  "x-invariants": [
    "Close requires all expected final dispositions and acknowledged dependencies.",
    "Source evidence arriving after closure becomes correction input only."
  ]
}
