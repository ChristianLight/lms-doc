{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradePolicyAssignment",
  "description": "Effective grade policy pinned to an EnrollmentRelease.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradePolicyAssignment identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "enrollment_id": {
      "type": "string",
      "format": "uuid",
      "description": "Enrollment in the named offering and institution.",
      "x-entity-reference": "Enrollment",
      "x-reference-scope": "Enrollment in the named offering and institution."
    },
    "enrollment_release_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact active or historical content release in same enrollment.",
      "x-entity-reference": "EnrollmentRelease",
      "x-reference-scope": "Exact active or historical content release in same enrollment."
    },
    "policy_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Published same-offering grade policy.",
      "x-entity-reference": "GradePolicyVersion",
      "x-reference-scope": "Published same-offering grade policy."
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive effective start."
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exclusive end, null while open."
    },
    "state": {
      "type": "string",
      "enum": [
        "staged",
        "active",
        "superseded",
        "cancelled"
      ],
      "default": "staged",
      "description": "Publication staging and active state."
    },
    "adoption_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Approved assignment scope fingerprint."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "enrollment_id",
    "enrollment_release_id",
    "policy_version_id",
    "effective_from",
    "effective_to",
    "state",
    "adoption_digest",
    "actor_id",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "enrollment_release_id",
      "effective_from"
    ]
  ],
  "x-invariants": [
    "Effective intervals cannot overlap for the enrollment.",
    "Staged rows are invisible until assignment batch activation."
  ]
}
