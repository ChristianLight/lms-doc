{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeRelease",
  "description": "Immutable staged set and active visibility guard for official grade publication.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradeRelease identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "academic_period_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Grading and reporting period within same institution.",
      "x-entity-reference": "AcademicPeriod",
      "x-reference-scope": "Grading and reporting period within same institution."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "learner_feedback",
        "interim",
        "final",
        "correction"
      ],
      "description": "Publication class."
    },
    "state": {
      "type": "string",
      "enum": [
        "staged",
        "approved",
        "active",
        "superseded",
        "revoked",
        "stale"
      ],
      "default": "staged",
      "description": "Staged, active and superseded visibility state."
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time",
      "description": "Approved academic evidence cutoff."
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Exact sorted result and audience manifest digest."
    },
    "ready_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Number of valid entries staged."
    },
    "blocked_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Blocked scoped results."
    },
    "allow_partial": {
      "type": "boolean",
      "default": false,
      "description": "Selective eligible final release permitted for this staged set."
    },
    "scope_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Compare-and-swap scope guard version."
    },
    "prepared_by": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized preparer in offering scope.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized preparer in offering scope."
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Authorized release reviewer in offering scope.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized release reviewer in offering scope."
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approval timestamp, absent before approval."
    },
    "activated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Actual learner visibility activation time."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "academic_period_id",
    "purpose",
    "state",
    "cutoff_at",
    "manifest_digest",
    "ready_count",
    "blocked_count",
    "allow_partial",
    "scope_version",
    "prepared_by",
    "approved_by",
    "approved_at",
    "activated_at",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "offering_id",
      "purpose",
      "manifest_digest"
    ]
  ],
  "x-invariants": [
    "Manifest digest and entries freeze at staging completion.",
    "No entry becomes visible before parent activation.",
    "Activation checks current evidence and all scope guards."
  ]
}
