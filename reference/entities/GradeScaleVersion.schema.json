{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradeScaleVersion",
  "description": "Published numeric, ordinal or completion scale with exact threshold and presentation policy.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique GradeScaleVersion identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "scale_key": {
      "type": "string",
      "format": "uuid",
      "description": "Stable grade scale family identifier within institution."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic immutable revision number within its stable identity."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Staff display name."
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "superseded",
        "retired"
      ],
      "default": "draft",
      "description": "Current publication lifecycle."
    },
    "scale_type": {
      "type": "string",
      "enum": [
        "percentage",
        "ordinal",
        "completion"
      ],
      "default": "percentage",
      "description": "Permitted interpretation of grade bands."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9-]+$",
      "default": "en",
      "description": "Default approved label locale."
    },
    "cap_ratio": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19727})$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19727}$"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false,
      "description": "Maximum representable ratio, inclusive."
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lower": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19727})$"
                  },
                  "denominator": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19727}$"
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "upper": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19727})$"
                  },
                  "denominator": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19727}$"
                  }
                },
                "required": [
                  "numerator",
                  "denominator"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "gpa_points": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{0,5}[1-9])?|1000000)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "required": [
          "code",
          "label",
          "lower",
          "upper",
          "gpa_points",
          "passed",
          "sort_order"
        ],
        "additionalProperties": false
      },
      "maxItems": 256,
      "minItems": 1,
      "description": "Ordered immutable bands with versioned GPA mapping."
    },
    "display_rounding": {
      "type": "string",
      "enum": [
        "half_up",
        "half_even",
        "truncate"
      ],
      "default": "half_up",
      "description": "Decimal display rounding only by default."
    },
    "display_places": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "default": 2,
      "description": "Number of displayed decimal percentage places."
    },
    "threshold_basis": {
      "type": "string",
      "enum": [
        "exact",
        "display_rounded"
      ],
      "default": "exact",
      "description": "Threshold comparison basis."
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Publication instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "scale_key",
    "revision",
    "created_at",
    "name",
    "state",
    "scale_type",
    "locale",
    "cap_ratio",
    "bands",
    "display_rounding",
    "display_places",
    "threshold_basis",
    "published_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "scale_key",
      "revision"
    ]
  ],
  "x-invariants": [
    "Published percentage bands have positive range, cannot overlap and cover zero through cap. Ordinal and completion bands have null numeric bounds and a unique ordered code.",
    "Final upper limit inclusive and remaining upper limits exclusive.",
    "Scale label changes require new revision."
  ]
}
