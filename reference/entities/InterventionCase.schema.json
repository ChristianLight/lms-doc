{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterventionCase",
  "description": "Scoped learner support work item derived from explained source facts.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique InterventionCase identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "enrollment_id": {
      "type": "string",
      "format": "uuid",
      "description": "Enrollment in the named offering and institution.",
      "x-entity-reference": "Enrollment",
      "x-reference-scope": "Enrollment in the named offering and institution."
    },
    "rule_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact enabled support rule.",
      "x-entity-reference": "InterventionRuleVersion",
      "x-reference-scope": "Exact enabled support rule."
    },
    "trigger_window_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Canonical window key for idempotent case trigger."
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time boundary at which source data was evaluated."
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Authorized minimal source signal lineage digest."
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      },
      "maxItems": 20,
      "minItems": 1,
      "uniqueItems": true,
      "description": "Safe decision explanation codes."
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "waiting",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "Support case workflow."
    },
    "assigned_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scoped active instructor or adviser when assigned.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Scoped active instructor or adviser when assigned."
    },
    "pointer_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 1,
      "description": "Case compare-and-swap token version."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "enrollment_id",
    "rule_version_id",
    "trigger_window_key",
    "cutoff_at",
    "evidence_digest",
    "reason_codes",
    "state",
    "assigned_to",
    "pointer_version",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "enrollment_id",
      "rule_version_id",
      "trigger_window_key"
    ]
  ],
  "x-invariants": [
    "Support case cannot modify grades or access eligibility.",
    "Corrected source signal can close case with history."
  ]
}
