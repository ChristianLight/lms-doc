{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemBank",
  "description": "Scoped collection controlling authorship, access, reuse and copy.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique ItemBank identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institution that owns the bank.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Institution that owns the bank."
    },
    "owner_kind": {
      "type": "string",
      "enum": [
        "Institution",
        "OrganizationUnit",
        "Course"
      ],
      "description": "Declared owner hierarchy type."
    },
    "owner_scope_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institution, organizational unit or course UUID selected by owner kind."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Human-readable name."
    },
    "normalized_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Trimmed, NFC and case-folded name used for scoped uniqueness."
    },
    "created_by": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized creator within the same institution.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized creator within the same institution."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative creation time."
    },
    "archived_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Time new activity against the bank was stopped."
    },
    "default_license": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ],
      "description": "License identifier used only as authoring default."
    }
  },
  "required": [
    "id",
    "institution_id",
    "owner_kind",
    "owner_scope_id",
    "name",
    "normalized_name",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "assessment",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "owner_kind",
      "owner_scope_id",
      "normalized_name"
    ]
  ],
  "x-invariants": [
    "Archive blocks new reuse and keeps historical versions resolvable.",
    "Cross-institution bank sharing requires explicit copy or transfer."
  ]
}
