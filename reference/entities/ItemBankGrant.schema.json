{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemBankGrant",
  "description": "Explicit access operations delegated within one bank.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique ItemBankGrant identifier."
    },
    "bank_id": {
      "type": "string",
      "format": "uuid",
      "description": "Bank whose authority is delegated.",
      "x-entity-reference": "ItemBank",
      "x-reference-scope": "Bank whose authority is delegated."
    },
    "principal_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized institutional user or service.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized institutional user or service."
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "draft",
          "preview",
          "review",
          "publish",
          "reuse",
          "copy",
          "read_keys"
        ]
      },
      "minItems": 1,
      "maxItems": 7,
      "description": "Allowed bank operations delegated to the recorded recipient."
    },
    "granted_by": {
      "type": "string",
      "format": "uuid",
      "description": "Manager authorized to delegate all listed operations.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Manager authorized to delegate all listed operations."
    },
    "granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative start time."
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional explicit revocation cutoff."
    }
  },
  "required": [
    "id",
    "bank_id",
    "principal_id",
    "operations",
    "granted_by",
    "granted_at"
  ],
  "additionalProperties": false,
  "x-owner": "assessment",
  "x-unique-keys": [
    [
      "id"
    ]
  ],
  "x-invariants": [
    "Operations cannot widen beyond grantor authority.",
    "Current principal eligibility required for access."
  ]
}
