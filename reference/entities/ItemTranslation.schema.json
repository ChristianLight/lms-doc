{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemTranslation",
  "description": "Candidate-facing locale overlay for one item version.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique ItemTranslation identifier."
    },
    "item_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Item version in the same bank and revision.",
      "x-entity-reference": "ItemVersion",
      "x-reference-scope": "Item version in the same bank and revision."
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,6}$",
      "description": "Distinct requested localization."
    },
    "prompt": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "format": {
                "type": "string",
                "enum": [
                  "sanitized_html",
                  "text",
                  "asset",
                  "math"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000
              },
              "asset_version_id": {
                "type": "string",
                "format": "uuid"
              },
              "accessible_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "parent_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "key",
              "format",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "format": {
                "type": "string",
                "enum": [
                  "interaction"
                ]
              },
              "interaction_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "parent_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "key",
              "format",
              "interaction_key"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "format": {
                "type": "string",
                "enum": [
                  "container"
                ]
              },
              "container_kind": {
                "type": "string",
                "enum": [
                  "flow",
                  "inline_flow",
                  "paragraph",
                  "ordered_list",
                  "unordered_list",
                  "list_item",
                  "table",
                  "table_caption",
                  "table_head",
                  "table_body",
                  "table_foot",
                  "table_row",
                  "table_header",
                  "table_cell"
                ]
              },
              "parent_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "table_semantics": {
                "type": "string",
                "enum": [
                  "data",
                  "layout"
                ]
              },
              "header_scope": {
                "type": "string",
                "enum": [
                  "row",
                  "col",
                  "rowgroup",
                  "colgroup"
                ]
              },
              "header_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 32,
                "minItems": 0
              },
              "row_span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "column_span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "list_start": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "key",
              "format",
              "container_kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 2048,
      "minItems": 1,
      "description": "Ordered public preorder forest of rich leaves, layout containers and stable interaction slots. Parent keys resolve earlier in this exact graph."
    },
    "interaction_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Canonical key coverage in actual displayed order."
    },
    "option_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "interaction_key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "interaction_key",
          "keys"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Versioned ordered keys grouped by interaction, where local option keys retain their original meaning."
    },
    "reviewed_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Reviewer with bank and locale capability.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Reviewer with bank and locale capability."
    },
    "approved_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Independent language approval time."
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "interaction_key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "accessible_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "leading_content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "sanitized_html",
                    "text",
                    "asset",
                    "math"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "asset_version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "accessible_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "key",
                "format",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 8,
            "minItems": 1
          },
          "trailing_content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "sanitized_html",
                    "text",
                    "asset",
                    "math"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "asset_version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "accessible_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "key",
                "format",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 8,
            "minItems": 1
          },
          "option_labels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "option_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "display_content": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "format": {
                        "type": "string",
                        "enum": [
                          "sanitized_html",
                          "text",
                          "asset",
                          "math"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50000
                      },
                      "asset_version_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "accessible_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "key",
                      "format",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 16,
                  "minItems": 1
                }
              },
              "required": [
                "option_key",
                "label"
              ],
              "additionalProperties": false
            },
            "maxItems": 100,
            "minItems": 0
          }
        },
        "required": [
          "interaction_key",
          "label"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 0,
      "description": "Localized candidate labels, descriptions, control context and choice bodies by stable interaction and option keys."
    }
  },
  "required": [
    "id",
    "item_version_id",
    "locale",
    "prompt",
    "interaction_keys",
    "option_keys"
  ],
  "additionalProperties": false,
  "x-owner": "assessment",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "item_version_id",
      "locale"
    ]
  ],
  "x-invariants": [
    "Every canonical interaction and option key appears exactly once within its proper interaction.",
    "Translation does not alter expected values.",
    "Optional labels contain at most one localized label or rich choice body per exact stable source key. Missing overlay fields use the approved canonical localization fallback."
  ]
}
