{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemVersion",
  "description": "Immutable published prompt, response and evaluation graph.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique ItemVersion identifier."
    },
    "item_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable item whose bank controls access.",
      "x-entity-reference": "Item",
      "x-reference-scope": "Stable item whose bank controls access."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic revision within the item."
    },
    "base_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Earlier revision of the same item.",
      "x-entity-reference": "ItemVersion",
      "x-reference-scope": "Earlier revision of the same item."
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "withdrawn"
      ],
      "description": "Workflow lifecycle and new selection eligibility."
    },
    "draft_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Strong authoring compare-and-swap sequence."
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,6}$",
      "description": "Canonical authored language."
    },
    "prompt": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "format": {
                "type": "string",
                "enum": [
                  "sanitized_html",
                  "text",
                  "asset",
                  "math"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50000
              },
              "asset_version_id": {
                "type": "string",
                "format": "uuid"
              },
              "accessible_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "parent_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "key",
              "format",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "format": {
                "type": "string",
                "enum": [
                  "interaction"
                ]
              },
              "interaction_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "parent_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "key",
              "format",
              "interaction_key"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "format": {
                "type": "string",
                "enum": [
                  "container"
                ]
              },
              "container_kind": {
                "type": "string",
                "enum": [
                  "flow",
                  "inline_flow",
                  "paragraph",
                  "ordered_list",
                  "unordered_list",
                  "list_item",
                  "table",
                  "table_caption",
                  "table_head",
                  "table_body",
                  "table_foot",
                  "table_row",
                  "table_header",
                  "table_cell"
                ]
              },
              "parent_key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "table_semantics": {
                "type": "string",
                "enum": [
                  "data",
                  "layout"
                ]
              },
              "header_scope": {
                "type": "string",
                "enum": [
                  "row",
                  "col",
                  "rowgroup",
                  "colgroup"
                ]
              },
              "header_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 32,
                "minItems": 0
              },
              "row_span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "column_span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "list_start": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "key",
              "format",
              "container_kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 2048,
      "minItems": 1,
      "description": "Ordered public preorder forest of rich leaves, layout containers and stable interaction slots. Parent keys resolve earlier in this exact graph."
    },
    "asset_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0,
      "maxItems": 1000,
      "description": "Approved immutable assets belonging to the institution and permitted bank.",
      "x-entity-reference": "AssetVersion",
      "x-reference-scope": "Approved immutable assets belonging to the institution and permitted bank."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 128,
      "description": "Non-sensitive taxonomy and search tags."
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Digest over the complete versioned graph."
    },
    "created_by": {
      "type": "string",
      "format": "uuid",
      "description": "Author or drafting service with bank grant.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Author or drafting service with bank grant."
    },
    "published_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Independent authorized releasing principal.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Independent authorized releasing principal."
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Effective published time."
    },
    "outcome_reference_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0,
      "maxItems": 1000,
      "description": "Scoped institution-owned outcome references approved through curriculum."
    },
    "license_reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ],
      "description": "Applicable content rights and reuse license identifier."
    }
  },
  "required": [
    "id",
    "item_id",
    "revision",
    "state",
    "draft_version",
    "locale",
    "prompt",
    "asset_version_ids",
    "tags",
    "content_digest",
    "created_by"
  ],
  "additionalProperties": false,
  "x-owner": "assessment",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "item_id",
      "revision"
    ]
  ],
  "x-invariants": [
    "One editable draft per item by default.",
    "Approval binds exact content digest.",
    "Published content graph cannot change.",
    "At most 64 interactions, 128 criteria and 2,048 prompt nodes at depth 16, with a 256 KiB cumulative normalized public content budget per item.",
    "When prompt slots are used, every interaction has one exact slot. Container ancestry and preorder must be valid. Rich content leaves cannot contain executable control placeholders."
  ]
}
