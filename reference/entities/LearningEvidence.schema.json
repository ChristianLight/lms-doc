{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningEvidence",
  "description": "Append-only validated event that can contribute to participation.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable opaque identity."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Evidence deduplication and ownership boundary.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Same as the cited enrollment release and authenticated producer namespace."
    },
    "enrollment_release_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact assignment.",
      "x-entity-reference": "EnrollmentRelease",
      "x-reference-scope": "Must resolve to an authorized EnrollmentRelease in the owning institution."
    },
    "content_placement_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact delivered occurrence.",
      "x-entity-reference": "ContentPlacement",
      "x-reference-scope": "Exact placement must belong to the course version in the cited EnrollmentRelease."
    },
    "source_namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "description": "Authenticated trusted producer."
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Stable producer event key."
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Version for replaceable state."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic release-local ingestion sequence."
    },
    "kind": {
      "type": "string",
      "enum": [
        "acknowledgment",
        "view",
        "video_coverage",
        "assessment_submission",
        "assessment_result",
        "attendance",
        "package",
        "accessible_equivalent",
        "waiver",
        "carry"
      ],
      "description": "Typed event class."
    },
    "payload": {
      "type": "object",
      "maxProperties": 20,
      "description": "Validated source-kind payload and evidence references."
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Canonical replay comparison."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Source instant."
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative accepted instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "enrollment_release_id",
    "content_placement_id",
    "source_namespace",
    "source_event_id",
    "source_revision",
    "sequence",
    "kind",
    "payload",
    "digest",
    "occurred_at",
    "received_at"
  ],
  "additionalProperties": false,
  "x-owner": "participation",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "source_namespace",
      "source_event_id"
    ],
    [
      "enrollment_release_id",
      "sequence"
    ]
  ],
  "x-invariants": [
    "Same source key with changed digest conflicts.",
    "Client telemetry cannot stand in for trusted assessment or attendance.",
    "For multi-learner evidence fanout, each authoritative event uses one deterministic child event key per exact member release and placement. Cross-institution evidence cannot collide or disclose an existing key."
  ]
}
