{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningProgress",
  "description": "Rebuildable projection for one exact enrollment release and placement.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable opaque identity."
    },
    "enrollment_release_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact participation release.",
      "x-entity-reference": "EnrollmentRelease",
      "x-reference-scope": "Must resolve to an authorized EnrollmentRelease in the owning institution."
    },
    "content_placement_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact placement.",
      "x-entity-reference": "ContentPlacement",
      "x-reference-scope": "Exact placement must belong to the course version in the cited EnrollmentRelease."
    },
    "rule_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Evaluated rule.",
      "x-entity-reference": "LearningRuleVersion",
      "x-reference-scope": "Must resolve to an authorized LearningRuleVersion in the owning institution."
    },
    "state": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "exempt"
      ],
      "default": "not_started",
      "description": "Display lifecycle."
    },
    "first_evidence_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "First accepted relevant instant."
    },
    "last_evidence_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Most recent accepted relevant instant."
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": 0,
      "description": "Accepted distinct count."
    },
    "projected_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": 0,
      "description": "Last processed sequence."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 1,
      "description": "Projection compare-and-swap token."
    }
  },
  "required": [
    "id",
    "enrollment_release_id",
    "content_placement_id",
    "state",
    "evidence_count",
    "projected_sequence",
    "revision"
  ],
  "additionalProperties": false,
  "x-owner": "participation",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "enrollment_release_id",
      "content_placement_id"
    ]
  ],
  "x-invariants": [
    "Projection cannot mutate a CompletionRecord.",
    "Historical releases remain separately addressable."
  ]
}
