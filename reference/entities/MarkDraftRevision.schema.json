{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarkDraftRevision",
  "description": "Private marker draft snapshot retained for attribution and reassignment audit.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique MarkDraftRevision identifier."
    },
    "assignment_id": {
      "type": "string",
      "format": "uuid",
      "description": "The exact scoped marking task.",
      "x-entity-reference": "MarkingAssignment",
      "x-reference-scope": "The exact scoped marking task."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic draft snapshot revision within assignment."
    },
    "marker_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authenticated assigned writer at time of save.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authenticated assigned writer at time of save."
    },
    "rubric_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Pinned same-item scoring guide.",
      "x-entity-reference": "RubricVersion",
      "x-reference-scope": "Pinned same-item scoring guide."
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "points": {
            "type": "string",
            "pattern": "^(?!-0(?![\\s\\S]))-?(0|[1-9][0-9]{0,8})(\\.[0-9]{0,5}[1-9])?(?![\\s\\S])"
          },
          "maximum": {
            "type": "string",
            "pattern": "^(?!-0(?![\\s\\S]))-?(0|[1-9][0-9]{0,8})(\\.[0-9]{0,5}[1-9])?(?![\\s\\S])"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "scored",
              "blank",
              "invalid",
              "manual_review",
              "excused"
            ]
          },
          "feedback_code": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "criterion_key",
          "maximum",
          "disposition"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Typed private rubric score draft."
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "candidate",
              "marker_only"
            ]
          }
        },
        "required": [
          "criterion_key",
          "text",
          "visibility"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Scoped draft comments with declared visibility."
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Exact draft values and attribution digest."
    },
    "saved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative save time."
    }
  },
  "required": [
    "id",
    "assignment_id",
    "revision",
    "marker_id",
    "rubric_version_id",
    "criteria",
    "comments",
    "digest",
    "saved_at"
  ],
  "additionalProperties": false,
  "x-owner": "assessment",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "assignment_id",
      "revision"
    ]
  ],
  "x-invariants": [
    "A subsequent marker cannot submit a draft authored under former marker assignment.",
    "Candidate projection has no access."
  ]
}
