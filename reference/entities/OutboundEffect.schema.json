{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutboundEffect",
  "description": "Durable and reconcilable intent for one remote side effect.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Server-assigned opaque identity. Never reused."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institution owning this record",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Exact institution root"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant of initial durable creation. Server assigned."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Starts at 1. Increment exactly once per authoritative mutation."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant of the latest authoritative mutation. Server assigned."
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "description": "Remote connector installation.",
      "x-entity-reference": "IntegrationConnection",
      "x-reference-scope": "Same institution and applicable scope"
    },
    "connection_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Configuration pinned when intent was prepared."
    },
    "job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Logical job responsible for initiating or reconciling this effect.",
      "x-entity-reference": "PlatformJob",
      "x-reference-scope": "Same institution and applicable scope"
    },
    "action_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Approved provider action."
    },
    "resource_scope_id": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical authorized target."
    },
    "effect_key": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Stable provider deduplication identity."
    },
    "request_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the authorized normalized payload and recipient."
    },
    "provider_receipt_ref": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Verified remote outcome evidence under custody."
    },
    "dispatched_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "First guarded send time."
    },
    "confirmed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Verified outcome confirmation time."
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "dispatched",
        "confirmed",
        "uncertain",
        "suppressed"
      ],
      "description": "Current lifecycle state. Mutate only through declared transitions."
    }
  },
  "required": [
    "id",
    "institution_id",
    "created_at",
    "version",
    "updated_at",
    "connection_id",
    "connection_version",
    "job_id",
    "action_key",
    "resource_scope_id",
    "effect_key",
    "request_digest",
    "state"
  ],
  "additionalProperties": false,
  "x-owner": "platform",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "connection_id",
      "effect_key"
    ]
  ],
  "x-invariants": [
    "Persist prepared intent before any network send. Never change recipient or body under a previously used effect key.",
    "An effect marked dispatched with no verified result is treated as possibly accepted after worker failure."
  ]
}
