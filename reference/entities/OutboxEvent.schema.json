{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutboxEvent",
  "description": "Immutable event committed atomically with an authoritative domain change.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Server-assigned opaque identity. Never reused."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institution owning this record",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Exact institution root"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant of initial durable creation. Server assigned."
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Stable domain aggregate type."
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owner aggregate UUID."
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Version of aggregate after the change."
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Zero-based stable order for events emitted by one version."
    },
    "event_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Registered event contract name."
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Registered payload schema version."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC commit-side occurrence time."
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Originating workflow identifier."
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Event or command ID that caused this event."
    },
    "payload_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical allowlisted payload or protected record pointer."
    }
  },
  "required": [
    "id",
    "institution_id",
    "created_at",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "ordinal",
    "event_name",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "payload_ref"
  ],
  "additionalProperties": false,
  "x-owner": "platform",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "aggregate_type",
      "aggregate_id",
      "aggregate_version",
      "ordinal"
    ]
  ],
  "x-invariants": [
    "An outbox event is insert-only and never gains new effects through replay.",
    "Only selected declared payload fields cross subsystem boundaries. Do not send PII or learner responses in generic messages."
  ]
}
