{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Program",
  "description": "Stable institutional programme of study or credential pathway.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique Program identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "organization_unit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Academic programme owner in institution.",
      "x-entity-reference": "OrganizationUnit",
      "x-reference-scope": "Academic programme owner in institution."
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Unique institutional programme code."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Current display title."
    },
    "level_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Institutional award level or framework code."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "retired"
      ],
      "default": "active",
      "description": "Catalog availability."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "organization_unit_id",
    "code",
    "title",
    "level_code",
    "state",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "code"
    ]
  ],
  "x-invariants": [
    "Retirement stops new assignments while preserving requirements and awards."
  ]
}
