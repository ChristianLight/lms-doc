{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualificationDecision",
  "description": "Approved institutional award, correction or revocation from a programme audit.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique QualificationDecision identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Educational identity within the same institution.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Educational identity within the same institution."
    },
    "program_enrollment_id": {
      "type": "string",
      "format": "uuid",
      "description": "Programme participation of same person.",
      "x-entity-reference": "ProgramEnrollment",
      "x-reference-scope": "Programme participation of same person."
    },
    "program_audit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Exact approved non-hypothetical audit.",
      "x-entity-reference": "ProgramAuditResult",
      "x-reference-scope": "Exact approved non-hypothetical audit."
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Corrected decision for same award lineage if any.",
      "x-entity-reference": "QualificationDecision",
      "x-reference-scope": "Corrected decision for same award lineage if any."
    },
    "renewal_of_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Prior qualification linked for renewal.",
      "x-entity-reference": "QualificationDecision",
      "x-reference-scope": "Prior qualification linked for renewal."
    },
    "status": {
      "type": "string",
      "enum": [
        "awarded",
        "suspended",
        "revoked",
        "superseded"
      ],
      "description": "Institutional decision type."
    },
    "award_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Authorized institutional qualification code."
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "description": "Official academic award effective time."
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exclusive expiry if policy sets one."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Approved rationale or correction record."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "person_id",
    "program_enrollment_id",
    "program_audit_id",
    "supersedes_id",
    "renewal_of_id",
    "status",
    "award_code",
    "effective_at",
    "expires_at",
    "reason",
    "actor_id",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ]
  ],
  "x-invariants": [
    "Award requires satisfied approved programme audit.",
    "Renewal uses distinct enrolment or approved programme renewal state."
  ]
}
