{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecalculationTarget",
  "description": "One independently retryable revision comparison within a run.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique RecalculationTarget identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "offering_id": {
      "type": "string",
      "format": "uuid",
      "description": "Offering within the same institution.",
      "x-entity-reference": "CourseOffering",
      "x-reference-scope": "Offering within the same institution."
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning run in same offering.",
      "x-entity-reference": "RecalculationRun",
      "x-reference-scope": "Owning run in same offering."
    },
    "grade_result_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable recalculation target.",
      "x-entity-reference": "GradeResult",
      "x-reference-scope": "Stable recalculation target."
    },
    "base_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Prior scoped revision used to compare, if any.",
      "x-entity-reference": "GradeResultRevision",
      "x-reference-scope": "Prior scoped revision used to compare, if any."
    },
    "candidate_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "New computed candidate if successful.",
      "x-entity-reference": "GradeResultRevision",
      "x-reference-scope": "New computed candidate if successful."
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Per-target frozen policy and evidence digest."
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "leased",
        "ready",
        "failed",
        "stale",
        "applied"
      ],
      "default": "queued",
      "description": "Independent target processing status."
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exclusive worker lease validity."
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scoped recoverable computation error."
    },
    "difference_kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "unchanged",
            "score",
            "outcome",
            "eligibility",
            "multiple"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Primary preview difference."
    },
    "revision_guard": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Compare-and-swap target guard."
    }
  },
  "required": [
    "id",
    "institution_id",
    "offering_id",
    "run_id",
    "grade_result_id",
    "base_revision_id",
    "candidate_revision_id",
    "input_fingerprint",
    "state",
    "lease_expires_at",
    "error_code",
    "difference_kind",
    "revision_guard"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "run_id",
      "grade_result_id"
    ]
  ],
  "x-invariants": [
    "Lease expiry allows same logical target retry.",
    "Candidate cannot publish official grade without release."
  ]
}
