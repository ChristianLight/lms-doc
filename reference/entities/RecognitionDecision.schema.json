{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecognitionDecision",
  "description": "Append-only decision on recognized study, credit or requirement mapping.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique RecognitionDecision identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Educational identity within the same institution.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Educational identity within the same institution."
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Original authorized recognition request.",
      "x-entity-reference": "RecognitionRequest",
      "x-reference-scope": "Original authorized recognition request."
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Prior decision for same recognition.",
      "x-entity-reference": "RecognitionDecision",
      "x-reference-scope": "Prior decision for same recognition."
    },
    "predecessor_key": {
      "type": "string",
      "pattern": "^(root|[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12})$",
      "description": "Canonical nonnull key, root for first decision or superseded decision UUID."
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Approved immutable evidence snapshot digest."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "revoked"
      ],
      "description": "Disposition of evidence recognition."
    },
    "mapped_course_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approved institutional equivalence if any.",
      "x-entity-reference": "Course",
      "x-reference-scope": "Approved institutional equivalence if any."
    },
    "mapped_requirement_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact approved rule mapping if any.",
      "x-entity-reference": "ProgramRequirement",
      "x-reference-scope": "Exact approved rule mapping if any."
    },
    "credit_scheme_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Normalized credit unit if awarded.",
      "x-entity-reference": "CreditUnitSchemeVersion",
      "x-reference-scope": "Normalized credit unit if awarded."
    },
    "earned_credit_units": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{0,5}[1-9])?|1000000)$",
      "default": "0",
      "description": "Approved distinct credits. Waiver has zero by default."
    },
    "gpa_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Explicit reviewed inclusion in GPA."
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "description": "Academic recognition effective instant."
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional expiry of rule satisfaction."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Authorized reviewer rationale."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "person_id",
    "request_id",
    "supersedes_id",
    "predecessor_key",
    "evidence_digest",
    "outcome",
    "mapped_course_id",
    "mapped_requirement_id",
    "credit_scheme_id",
    "earned_credit_units",
    "gpa_eligible",
    "effective_at",
    "expires_at",
    "reason",
    "actor_id",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "request_id",
      "predecessor_key"
    ]
  ],
  "x-invariants": [
    "Predecessor key is root only for a first decision and otherwise equals superseded decision UUID. Lock recognition request head to prevent branching.",
    "Cannot grant external GPA silently.",
    "Nonzero credit requires approved unit scheme.",
    "Revoke by new decision."
  ]
}
