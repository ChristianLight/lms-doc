{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordDocumentStatusEvent",
  "description": "Append-only issued document state and public verification effect.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique RecordDocumentStatusEvent identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Educational identity within the same institution.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Educational identity within the same institution."
    },
    "report_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scoped report revision when applicable.",
      "x-entity-reference": "ReportCardRevision",
      "x-reference-scope": "Scoped report revision when applicable."
    },
    "transcript_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scoped transcript revision when applicable.",
      "x-entity-reference": "TranscriptRevision",
      "x-reference-scope": "Scoped transcript revision when applicable."
    },
    "event_kind": {
      "type": "string",
      "enum": [
        "issued",
        "superseded",
        "voided"
      ],
      "description": "Issuance or correction status event."
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "description": "Effective document status time."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "description": "Restricted correction rationale."
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized actor within institution at decision time.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized actor within institution at decision time."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "person_id",
    "report_revision_id",
    "transcript_revision_id",
    "event_kind",
    "effective_at",
    "reason",
    "actor_id",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ]
  ],
  "x-invariants": [
    "Exactly one document parent.",
    "Never replace old artifact content for same verification identifier."
  ]
}
