{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseRevision",
  "description": "Append-only accepted response or explicit clear marker.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique ResponseRevision identifier."
    },
    "attempt_item_id": {
      "type": "string",
      "format": "uuid",
      "description": "Item occurrence in caller-authorized sitting.",
      "x-entity-reference": "AttemptItem",
      "x-reference-scope": "Item occurrence in caller-authorized sitting."
    },
    "interaction_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "description": "Known response slot in item version."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Per-field monotonic sequence."
    },
    "writer_id": {
      "type": "string",
      "format": "uuid",
      "description": "Authorized candidate or team editor.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Authorized candidate or team editor."
    },
    "operation_key_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Fingerprint of the idempotent save operation."
    },
    "state": {
      "type": "string",
      "enum": [
        "valid",
        "cleared",
        "invalid_captured"
      ],
      "description": "Accepted response, explicit clear or formally captured invalid value."
    },
    "value": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "single_choice"
                  ]
                },
                "choice": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                }
              },
              "required": [
                "kind",
                "choice"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "multiple_choice"
                  ]
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                }
              },
              "required": [
                "kind",
                "choices"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "short_text"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "long_text"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 50000
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "matching"
                  ]
                },
                "pairs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "left": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "right": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      }
                    },
                    "required": [
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 100
                }
              },
              "required": [
                "kind",
                "pairs"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "ordering"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "minItems": 0,
                  "maxItems": 100,
                  "uniqueItems": true
                }
              },
              "required": [
                "kind",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "categorization"
                  ]
                },
                "placements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "category": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      }
                    },
                    "required": [
                      "item",
                      "category"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 100
                }
              },
              "required": [
                "kind",
                "placements"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "math"
                  ]
                },
                "input": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "locale": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,6}$"
                }
              },
              "required": [
                "kind",
                "input",
                "locale"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "quantity"
                  ]
                },
                "input": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "unit": {
                  "type": "string",
                  "maxLength": 128
                },
                "locale": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8}){0,6}$"
                }
              },
              "required": [
                "kind",
                "input",
                "unit",
                "locale"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "files"
                  ]
                },
                "asset_version_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 0,
                  "maxItems": 10,
                  "uniqueItems": true
                }
              },
              "required": [
                "kind",
                "asset_version_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "points"
                  ]
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "string",
                        "pattern": "^(?!-0(?![\\s\\S]))-?(0|[1-9][0-9]{0,8})(\\.[0-9]{0,5}[1-9])?(?![\\s\\S])"
                      },
                      "y": {
                        "type": "string",
                        "pattern": "^(?!-0(?![\\s\\S]))-?(0|[1-9][0-9]{0,8})(\\.[0-9]{0,5}[1-9])?(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 100
                }
              },
              "required": [
                "kind",
                "points"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Original typed value when present."
    },
    "canonical_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Private digest of normalized form and state."
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative admission instant."
    },
    "diagnostic_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Safe parse or validation state code."
    },
    "canonical_value_ref": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scoped protected reference to validated typed AST or canonical response when distinct from original."
    },
    "parser_profile_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ],
      "description": "Pinned response parser version when a typed parser is used."
    }
  },
  "required": [
    "id",
    "attempt_item_id",
    "interaction_key",
    "revision",
    "writer_id",
    "operation_key_hash",
    "state",
    "canonical_digest",
    "accepted_at"
  ],
  "additionalProperties": false,
  "x-owner": "assessment",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "attempt_item_id",
      "interaction_key",
      "revision"
    ]
  ],
  "x-invariants": [
    "Value and response state agree.",
    "Only admitted responses can become sealed evidence.",
    "Revisions are immutable."
  ]
}
