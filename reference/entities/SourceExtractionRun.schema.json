{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceExtractionRun",
  "description": "Exact protected source PDF extraction and review history.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable opaque identity."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Must resolve to an authorized Institution in the owning institution."
    },
    "source_asset_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Immutable authoring-source PDF.",
      "x-entity-reference": "AssetVersion",
      "x-reference-scope": "Same institution. AssetVersion has verified managed bytes and StorageObject purpose evidence."
    },
    "target_course_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional explicitly authorized teaching scope.",
      "x-entity-reference": "Course",
      "x-reference-scope": "Must resolve to an authorized Course in the owning institution."
    },
    "predecessor_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact sealed predecessor for corrections.",
      "x-entity-reference": "SourceExtractionRun",
      "x-reference-scope": "Must resolve to an authorized SourceExtractionRun in the owning institution."
    },
    "platform_job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Coordinator job.",
      "x-entity-reference": "PlatformJob",
      "x-reference-scope": "Same institution, job_kind course_import and target type SourceExtractionRun."
    },
    "requested_by_id": {
      "type": "string",
      "format": "uuid",
      "description": "Responsible scoped author.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Must resolve to an authorized Principal in the owning institution."
    },
    "rights_evidence_object_id": {
      "type": "string",
      "format": "uuid",
      "description": "Sealed usage attestation and reviewed rights basis.",
      "x-entity-reference": "StorageObject",
      "x-reference-scope": "Same institution. Platform purpose evidence and exact owner source AssetVersion. Resolve actual object version and digest before use."
    },
    "rights_snapshot": {
      "type": "object",
      "properties": {
        "rights_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "private_extract",
              "external_process",
              "adapt",
              "reuse_excerpt",
              "reuse_figure",
              "learner_download",
              "external_export",
              "publish_derived"
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "uniqueItems": true
        },
        "approved_by_id": {
          "type": "string",
          "format": "uuid"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time"
        },
        "export_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "maxItems": 20,
          "minItems": 0
        },
        "provider_connection_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipient_scope_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "maxItems": 40,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "rights_key",
        "policy_revision",
        "purposes",
        "approved_by_id",
        "effective_from",
        "effective_to",
        "export_profiles",
        "provider_connection_id",
        "approval_digest",
        "recipient_scope_codes"
      ],
      "additionalProperties": false,
      "description": "Approved use snapshot. Check current authority again before any protected effect."
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Measured verified source PDF SHA-256."
    },
    "profile_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
      "description": "Approved extraction profile and tool configuration."
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Canonical tool versions, limits and extraction parameters."
    },
    "page_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "to_page_inclusive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "from_page",
          "to_page_inclusive"
        ],
        "additionalProperties": false
      },
      "maxItems": 500,
      "minItems": 1,
      "description": "Normalized sorted nonoverlapping zero-based physical ranges."
    },
    "run_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Canonical source, profile, rights, range, predecessor and corrections identity."
    },
    "page_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100001
        },
        {
          "type": "null"
        }
      ],
      "description": "Physical count reported by trusted parser."
    },
    "committed_page_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 0,
      "description": "Number of accepted physical page receipts."
    },
    "manifest_object_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Sealed reviewed extraction manifest. Page inventory and tool transforms are indexed inside the manifest.",
      "x-entity-reference": "StorageObject",
      "x-reference-scope": "Same institution. Platform purpose evidence and exact owner SourceExtractionRun. Resolve actual object version and digest before use."
    },
    "manifest_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Verified canonical extraction manifest digest."
    },
    "reviewed_by_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Human approving exact manifest.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Must resolve to an authorized Principal in the owning institution."
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "extracting",
        "needs_review",
        "sealed",
        "blocked",
        "canceled"
      ],
      "default": "queued",
      "description": "Extraction lifecycle."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "default": 1,
      "description": "Run compare-and-swap revision."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Start instant."
    }
  },
  "required": [
    "id",
    "institution_id",
    "source_asset_version_id",
    "platform_job_id",
    "requested_by_id",
    "rights_evidence_object_id",
    "rights_snapshot",
    "source_digest",
    "profile_key",
    "profile_digest",
    "page_ranges",
    "run_fingerprint",
    "committed_page_count",
    "state",
    "revision",
    "created_at"
  ],
  "additionalProperties": false,
  "x-owner": "curriculum",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "institution_id",
      "run_fingerprint"
    ]
  ],
  "x-invariants": [
    "Source PDF is authoring-only and protected by managed evidence purpose.",
    "One accepted page shard per run and physical page. Sealed pages and regions are immutable.",
    "A corrected reading creates new sealed extraction with predecessor and new affected region keys.",
    "A sealed manifest reconciles exact page ordinals, evidence object identities, region digests and reviewed exclusions.",
    "Export and learner distribution require separate applicable purposes, recipient scope and profile authorization even after private extraction or adaptation."
  ]
}
