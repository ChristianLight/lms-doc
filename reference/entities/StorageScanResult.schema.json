{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorageScanResult",
  "description": "Immutable evidence of a particular scanner decision on exact content.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Server-assigned opaque identity. Never reused."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Institution owning this record",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Exact institution root"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC instant of initial durable creation. Server assigned."
    },
    "storage_object_id": {
      "type": "string",
      "format": "uuid",
      "description": "Object evaluated.",
      "x-entity-reference": "StorageObject",
      "x-reference-scope": "Same institution and applicable scope"
    },
    "content_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest of inspected bytes."
    },
    "engine_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Scanner engine and ruleset identification."
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Pinned file handling policy version."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "clean",
        "unsupported",
        "infected",
        "corrupt",
        "unsafe",
        "timeout"
      ],
      "description": "Normalized evidence result."
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Inspection time."
    },
    "safe_reason_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Safe failure detail code."
    }
  },
  "required": [
    "id",
    "institution_id",
    "created_at",
    "storage_object_id",
    "content_sha256",
    "engine_version",
    "policy_version",
    "verdict",
    "checked_at"
  ],
  "additionalProperties": false,
  "x-owner": "platform",
  "x-unique-keys": [
    [
      "id"
    ]
  ],
  "x-invariants": [
    "Verdict timeout is inconclusive and cannot enable serving.",
    "A changed digest requires a different object version or a rescan under matching provenance."
  ]
}
