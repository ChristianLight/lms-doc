{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptRevision",
  "description": "Approved structured transcript snapshot and pinned academic record cutoff.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable globally unique TranscriptRevision identifier."
    },
    "institution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Owning institution. All scoped references resolve inside it.",
      "x-entity-reference": "Institution",
      "x-reference-scope": "Owning institution. All scoped references resolve inside it."
    },
    "person_id": {
      "type": "string",
      "format": "uuid",
      "description": "Educational identity within the same institution.",
      "x-entity-reference": "Person",
      "x-reference-scope": "Educational identity within the same institution."
    },
    "transcript_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable transcript series for same learner.",
      "x-entity-reference": "Transcript",
      "x-reference-scope": "Stable transcript series for same learner."
    },
    "template_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "Published institution transcript template.",
      "x-entity-reference": "TranscriptTemplateVersion",
      "x-reference-scope": "Published institution transcript template."
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Previous same-series revision, when replaced.",
      "x-entity-reference": "TranscriptRevision",
      "x-reference-scope": "Previous same-series revision, when replaced."
    },
    "grade_release_entry_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 5000,
      "minItems": 0,
      "uniqueItems": true,
      "description": "Exact authorized final grade and correction pointers.",
      "x-entity-reference": "GradeReleaseEntry",
      "x-reference-scope": "Exact authorized final grade and correction pointers."
    },
    "credit_decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 5000,
      "minItems": 0,
      "uniqueItems": true,
      "description": "Approved institutional or transfer credit line revisions.",
      "x-entity-reference": "CreditDecision",
      "x-reference-scope": "Approved institutional or transfer credit line revisions."
    },
    "qualification_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 1000,
      "minItems": 0,
      "uniqueItems": true,
      "description": "Approved awards for this learner.",
      "x-entity-reference": "QualificationDecision",
      "x-reference-scope": "Approved awards for this learner."
    },
    "gpa": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19727})$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19727}$"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact GPA ratio before display rounding."
    },
    "gpa_credit_units": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{0,5}[1-9])?|1000000)$",
      "description": "Total credits contributing to GPA denominator."
    },
    "earned_credit_units": {
      "type": "string",
      "pattern": "^(?:(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{0,5}[1-9])?|1000000)$",
      "description": "Total approved and deduplicated earned credits."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Monotonic immutable revision number within its stable identity."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative recorded creation instant."
    },
    "state": {
      "type": "string",
      "enum": [
        "staged",
        "render_failed",
        "ready",
        "issued",
        "superseded",
        "void"
      ],
      "default": "staged",
      "description": "Rendering and issuance state."
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time",
      "description": "Exact academic cutoff."
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Pinned approved source references and scope digest."
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Canonical structured document content digest."
    },
    "snapshot_storage_id": {
      "type": "string",
      "format": "uuid",
      "description": "Protected immutable canonical snapshot bytes inside institution.",
      "x-entity-reference": "StorageObject",
      "x-reference-scope": "Protected immutable canonical snapshot bytes inside institution."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z0-9-]+$",
      "description": "Approved document locale."
    },
    "render_version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "description": "Renderer contract and layout algorithm version."
    },
    "issued_by": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Approver with authority to issue this document.",
      "x-entity-reference": "Principal",
      "x-reference-scope": "Approver with authority to issue this document."
    },
    "issued_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "Recorded official issuance timestamp."
    },
    "verification_key_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Digest of opaque verification code if enabled."
    },
    "classification": {
      "type": "string",
      "enum": [
        "internal",
        "private",
        "recipient_restricted"
      ],
      "default": "private",
      "description": "Maximum allowed disclosure."
    }
  },
  "required": [
    "id",
    "institution_id",
    "person_id",
    "transcript_id",
    "template_version_id",
    "supersedes_id",
    "grade_release_entry_ids",
    "credit_decision_ids",
    "qualification_ids",
    "gpa",
    "gpa_credit_units",
    "earned_credit_units",
    "revision",
    "created_at",
    "state",
    "cutoff_at",
    "input_digest",
    "snapshot_digest",
    "snapshot_storage_id",
    "locale",
    "render_version",
    "issued_by",
    "issued_at",
    "verification_key_digest",
    "classification"
  ],
  "additionalProperties": false,
  "x-owner": "records",
  "x-unique-keys": [
    [
      "id"
    ],
    [
      "transcript_id",
      "revision"
    ],
    [
      "transcript_id",
      "snapshot_digest",
      "input_digest"
    ]
  ],
  "x-invariants": [
    "Final release entries only.",
    "GPA null when no GPA-eligible credits.",
    "Issued revision and artifact digest remain unchanged after correction."
  ]
}
