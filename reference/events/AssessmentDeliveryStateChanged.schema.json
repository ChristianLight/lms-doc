{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentDeliveryStateChanged",
  "description": "New sessions become blocked or permitted.",
  "type": "object",
  "properties": {
    "delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "offering_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "suspended",
        "closed",
        "archived"
      ]
    },
    "write_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "delivery_id",
    "offering_id",
    "state",
    "write_version"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "assessment",
  "x-ordering": "Per AssessmentDelivery write_version.",
  "x-deduplication": "Deduplicate by event_id and verify monotonic revision in the named owner scope.",
  "x-privacy": "No incident or candidate data."
}
