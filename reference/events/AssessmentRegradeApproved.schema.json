{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssessmentRegradeApproved",
  "description": "Reviewed frozen correction plan can run.",
  "type": "object",
  "properties": {
    "regrade_job_id": {
      "type": "string",
      "format": "uuid"
    },
    "delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "preview_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "regrade_job_id",
    "delivery_id",
    "preview_digest"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "assessment",
  "x-ordering": "Per RegradeJob approval.",
  "x-deduplication": "Deduplicate by event_id and verify monotonic revision in the named owner scope.",
  "x-privacy": "Scope IDs only, no learner grades."
}
