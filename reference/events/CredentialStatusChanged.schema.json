{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialStatusChanged",
  "description": "Issued or subsequently transitioned credential status changed.",
  "type": "object",
  "properties": {
    "credential_id": {
      "type": "string",
      "format": "uuid"
    },
    "status_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "suspended",
        "reinstated",
        "revoked",
        "expired",
        "superseded"
      ]
    }
  },
  "required": [
    "credential_id",
    "status_event_id",
    "ordinal",
    "status"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "records",
  "x-ordering": "Per credential ordinal.",
  "x-deduplication": "status_event_id.",
  "x-privacy": "No claim data in event."
}
