{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurriculumExportCompleted",
  "description": "A reviewed export completed and has an authorized collection window.",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "format": {
      "type": "string",
      "enum": [
        "native_curriculum",
        "olx_course",
        "olx_legacy_library",
        "olx_versioned_library",
        "scorm_12",
        "scorm_2004_2",
        "scorm_2004_3",
        "scorm_2004_4",
        "qti_21",
        "qti_22",
        "qti_301",
        "common_cartridge"
      ]
    },
    "edition": {
      "type": "string",
      "enum": [
        "native_1",
        "olx_course_1",
        "olx_legacy_library_1",
        "olx_library_archive_1",
        "scorm_1_2",
        "scorm_2004_2",
        "scorm_2004_3",
        "scorm_2004_4",
        "qti_2_1",
        "qti_2_2",
        "qti_3_0_1",
        "common_cartridge_1_3"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "job_id",
    "revision",
    "format",
    "edition",
    "expires_at"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "interoperability",
  "x-ordering": "By export job revision.",
  "x-deduplication": "Stable outbox ID and export job revision. Identical command replay emits no new event.",
  "x-privacy": "Only opaque job ID, revision and approved format or decision. No source scopes, asset locators, solution data or download credentials."
}
