{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnrollmentChanged",
  "description": "Stable participation state or source authority changed.",
  "type": "object",
  "properties": {
    "enrollment_id": {
      "type": "string",
      "format": "uuid"
    },
    "offering_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "withdrawn",
        "closed"
      ]
    }
  },
  "required": [
    "enrollment_id",
    "offering_id",
    "revision",
    "state"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "participation",
  "x-ordering": "By enrollment revision.",
  "x-deduplication": "Enrollment and revision.",
  "x-privacy": "Restricted participation IDs only."
}
