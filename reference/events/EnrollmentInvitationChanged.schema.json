{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnrollmentInvitationChanged",
  "description": "An admission invitation was issued or revoked.",
  "type": "object",
  "properties": {
    "invitation_id": {
      "type": "string",
      "format": "uuid"
    },
    "offering_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "issued",
        "revoked"
      ]
    }
  },
  "required": [
    "invitation_id",
    "offering_id",
    "state"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "participation",
  "x-ordering": "Causal by invitation.",
  "x-deduplication": "Invitation ID and state.",
  "x-privacy": "No raw token, recipient name or contact."
}
