{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradePolicyAssignmentsActivated",
  "description": "Reviewed grade policy assignments became effective as a batch.",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "offering_id": {
      "type": "string",
      "format": "uuid"
    },
    "policy_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "batch_id",
    "offering_id",
    "policy_version_id",
    "effective_at"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "records",
  "x-ordering": "Per offering adoption guard.",
  "x-deduplication": "batch_id.",
  "x-privacy": "No enrollment list in message."
}
