{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibraryChanged",
  "description": "Library or entry publication changed.",
  "type": "object",
  "properties": {
    "library_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "entry_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "library_id",
    "revision",
    "entry_version_id"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "curriculum",
  "x-ordering": "By library change sequence.",
  "x-deduplication": "Library and revision plus entry version when present.",
  "x-privacy": "No private usage lists or content."
}
