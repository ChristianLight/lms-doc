{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerReviewAllocated",
  "description": "Frozen allocation or replacement can be fetched by authorized reviewer.",
  "type": "object",
  "properties": {
    "allocation_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "allocation_run_id",
    "delivery_id",
    "round"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "assessment",
  "x-ordering": "Per peer policy and round.",
  "x-deduplication": "Deduplicate by event_id and verify monotonic revision in the named owner scope.",
  "x-privacy": "No reviewer-to-candidate mapping."
}
