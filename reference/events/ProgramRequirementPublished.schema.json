{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgramRequirementPublished",
  "description": "Versioned programme rules approved for eligible admissions.",
  "type": "object",
  "properties": {
    "program_id": {
      "type": "string",
      "format": "uuid"
    },
    "requirement_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "required": [
    "program_id",
    "requirement_version_id",
    "revision"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "records",
  "x-ordering": "Per programme revision.",
  "x-deduplication": "requirement_version_id.",
  "x-privacy": "No learner data."
}
