{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolLaunchAuthorized",
  "description": "A browser-bound tool OIDC request consumed the matching login initiation challenge and was signed.",
  "type": "object",
  "properties": {
    "launch_id": {
      "type": "string",
      "format": "uuid"
    },
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "launch_kind": {
      "type": "string",
      "enum": [
        "resource",
        "deep_link"
      ]
    }
  },
  "required": [
    "launch_id",
    "deployment_id",
    "launch_kind"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "interoperability",
  "x-ordering": "Launch creation order.",
  "x-deduplication": "Single-use launch identity.",
  "x-privacy": "Do not emit tool state, nonce, signed ID token or learner profile."
}
