{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolResourceLinked",
  "description": "A scoped external resource link was staged for native publication.",
  "type": "object",
  "properties": {
    "resource_link_id": {
      "type": "string",
      "format": "uuid"
    },
    "deployment_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "resource_link_id",
    "deployment_id",
    "revision"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "interoperability",
  "x-ordering": "Resource link revision.",
  "x-deduplication": "Resource link and revision.",
  "x-privacy": "Restricted to institution operational consumers. Do not include learner answers, raw suspend data or credentials."
}
