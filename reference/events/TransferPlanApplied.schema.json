{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransferPlanApplied",
  "description": "A transfer generation crossed the native owner publication barrier.",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "job_id",
    "revision",
    "plan_digest",
    "generation_id"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "interoperability",
  "x-ordering": "Job revision.",
  "x-deduplication": "Job and promoted generation.",
  "x-privacy": "Restricted to institution operational consumers. Do not include learner answers, raw suspend data or credentials."
}
