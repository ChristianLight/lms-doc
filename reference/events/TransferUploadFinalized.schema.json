{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransferUploadFinalized",
  "description": "Whole-file bytes and size were durably verified.",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "artifact_id",
    "sha256",
    "byte_length"
  ],
  "additionalProperties": false,
  "x-version": 1,
  "x-producer": "interoperability",
  "x-ordering": "Artifact assembly sequence.",
  "x-deduplication": "Artifact UUID and digest.",
  "x-privacy": "Restricted to institution operational consumers. Do not include learner answers, raw suspend data or credentials."
}
