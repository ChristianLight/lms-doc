{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored LMS domain catalog",
  "type": "object",
  "properties": {
    "catalog_version": {
      "const": "1.0.0"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "security_schemes": {
      "type": "object"
    }
  },
  "required": [
    "catalog_version",
    "domain",
    "entities",
    "commands",
    "events",
    "permissions",
    "scenarios"
  ],
  "additionalProperties": true,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "string",
          "minLength": 1
        },
        "reference_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "schema",
        "required",
        "nullable",
        "description"
      ],
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "unique_keys": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fields",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "guard": {
                "type": "string",
                "minLength": 1
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "from",
              "to",
              "command",
              "guard",
              "effects"
            ],
            "additionalProperties": false
          }
        },
        "schema_rules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Additional cross-field JSON Schema constraints applied with allOf."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "name",
        "description",
        "owner",
        "identity",
        "fields",
        "unique_keys",
        "indexes",
        "invariants",
        "retention"
      ],
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/v1/"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "request_schema": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "response_schema": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "success_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "idempotency": {
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "concurrency": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transaction": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 400,
                "maximum": 599
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "recovery": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "code",
              "condition",
              "recovery"
            ],
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "request_examples": {
          "type": "array"
        },
        "response_examples": {
          "type": "array"
        },
        "parameter_locations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "in": {
                "enum": [
                  "header",
                  "query",
                  "cookie"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "in",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "security": {
          "type": "array"
        }
      },
      "required": [
        "name",
        "method",
        "path",
        "description",
        "permission",
        "request_schema",
        "response_schema",
        "success_status",
        "idempotency",
        "concurrency",
        "preconditions",
        "transaction",
        "errors",
        "events"
      ],
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "payload_schema": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "ordering": {
          "type": "string",
          "minLength": 1
        },
        "deduplication": {
          "type": "string",
          "minLength": 1
        },
        "privacy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "description",
        "producer",
        "payload_schema",
        "ordering",
        "deduplication",
        "privacy"
      ],
      "additionalProperties": true
    },
    "permission": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "default_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "key",
        "description",
        "scopes",
        "default_roles",
        "constraints"
      ],
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "given": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "then": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixtures": {}
      },
      "required": [
        "id",
        "title",
        "covers",
        "given",
        "when",
        "then"
      ],
      "additionalProperties": true
    }
  }
}
